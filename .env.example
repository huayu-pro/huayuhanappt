# ============================================================================
# 华予&Hanako PPT —— 环境变量配置模板
# ============================================================================
# 使用方法：
#   1. 复制此文件为 .env（与 huayu_hanako_ppt.py 同目录）
#   2. 填入你自己的 API 密钥
#   3. 一个密钥都不填也能用——Bing 与 Wikimedia 免密钥
#
# 更方便的方式：python start_ui.py，在网页里直接填
#
# ⚠️  请勿将 .env 文件提交至 GitHub 等公开仓库！
#      （本文件 .env.example 可以提交，用于给其他人参考）
# ============================================================================

# ---- Bing 图片（默认 ①，免密钥，国内可达）----
# 无需配置

# ---- Pexels（②，高质量摄影图）----
# 申请地址：https://www.pexels.com/api/
# 限额：200 次/小时
PEXELS_API_KEY=

# ---- 百度图片（③，中文关键词优势）----
# 申请地址：https://console.bce.baidu.com/ai/
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---- Unsplash（④，顶级免费图库）----
# 申请地址：https://unsplash.com/developers
# 限额：50 次/小时
UNSPLASH_ACCESS_KEY=

# ---- Wikimedia Commons（⑤，免密钥，知识共享许可）----
# 无需配置

# ---- Pixabay（⑥，覆盖面广，兜底）----
# 申请地址：https://pixabay.com/service/about/api/
PIXABAY_API_KEY=
